# Template for local configuration. Copy it, then fill in the secret key:
#
#   copy .env.example .env
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# `.env` is git-ignored; this file is committed. Real environment variables
# win over anything set here, so CI and containers need no .env at all.
#
# Nothing in this file may be a real credential. It documents which knobs
# exist and what a sane local value looks like — that is all.

# --- Core -------------------------------------------------------------------

# Required. Startup fails if this is empty while DJANGO_DEBUG is false.
DJANGO_SECRET_KEY=

# Keep false anywhere shared. true enables the browsable API, dev media
# serving, and detailed error pages.
DJANGO_DEBUG=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# --- Database ---------------------------------------------------------------
# PostgreSQL. `docker compose up -d db` starts a server that
# matches the values below exactly, so this section works unedited.
#
# DB_ENGINE=sqlite is an escape hatch for offline schema work only. SQLite
# ignores select_for_update(), so the stock ledger's row locking silently does
# nothing there, and concurrency tests skip themselves.
# `manage.py check` warns while DEBUG is on and fails the build when it is off.

DB_ENGINE=postgresql

DB_NAME=shivalik
DB_USER=shivalik
DB_PASSWORD=shivalik
DB_HOST=127.0.0.1
DB_PORT=5432

# Seconds to keep a connection open between requests. 0 disables pooling.
DB_CONN_MAX_AGE=60

# Only read when DB_ENGINE=sqlite. Deliberately not DB_NAME, so switching
# engines is one line and cannot half-apply.
SQLITE_NAME=db.sqlite3


# --- API --------------------------------------------------------------------

# Where the Vite dev server runs. Add deployed frontends here, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

API_PAGE_SIZE=25


# --- Permissions ------------------------------------------------------------
# Team D publishes the role permission classes as stubs that admit any
# authenticated caller. Turning this on activates the real role checks — and
# any class whose `allowed_roles` is still empty will then deny everyone.
# Flip it only when the permission matrix is filled in, and say so in the
# group chat first: views that were passing will start returning 403.

ENFORCE_ROLE_PERMISSIONS=false

# The login IP allow-list. When on, `/api/v1/auth/login/` refuses any client
# whose IP has no `WhitelistedIP` row — and that table starts empty, so
# turning this on before you have populated it locks everybody out, superuser
# included. Unset, it follows DEBUG: off while you develop, on in anything
# deployed. Populate the allow-list through /admin/ before you rely on it.

ENFORCE_IP_ALLOWLIST=false


# --- Media ------------------------------------------------------------------

# Directory under backend-shivalik/ for uploaded contracts and book covers.
MEDIA_DIRNAME=media


# --- Domain -----------------------------------------------------------------

# Dead stock is computed on read. This is the global fallback; individual
# titles can override it with Book.dead_stock_threshold_days.
DEAD_STOCK_DEFAULT_DAYS=90
